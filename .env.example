# Copy to .env and fill in. Used by the scripts under python/ and by the
# protonmail-jobs container.
# Precedence: CLI flags > environment variables > this file > built-in defaults.

# --- Bridge connection (IMAP) -------------------------------------------------
# Credentials are the ones the Bridge prints via `info`, not your Proton login.
PMB_IMAP_HOST=127.0.0.1
PMB_IMAP_PORT=1143
PMB_USER=your.email@proton.me
PMB_PASSWORD=bridge-mailbox-password

# --- Mail layout --------------------------------------------------------------
# IMAP prefix under which labels are exposed by the Bridge.
PMB_LABEL_ROOT=Labels
# Folder that unlabeled INBOX mail is moved to by python/unlabeled_mover.py.
PMB_TARGET=Folders/Unlabeled
# Only act on messages older than this many hours (lets Sieve labels sync first).
PMB_MIN_AGE_HOURS=24

# --- Labeled mail (python/labeled_mover.py) -----------------------------------
# Labels that must never be archived (comma-separated). Include your forwarding
# queue label so queued mail is not archived before it is forwarded.
PMB_KEEP_LABELS=example.com,newsletters,forward

# --- Forwarding queue (python/erasmus_forwarder.py) ---------------------------
# Label treated as the forwarding queue.
PMB_FORWARD_LABEL=forward
# Destination address that queued mail is forwarded to.
PMB_FORWARD_TO=destination@example.com
# From address; defaults to PMB_USER. Must be one of your own addresses.
# PMB_FORWARD_FROM=your.email@proton.me
# Bridge SMTP endpoint.
PMB_SMTP_HOST=127.0.0.1
PMB_SMTP_PORT=1025
